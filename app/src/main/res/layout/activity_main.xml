<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 中间内容区域 (各个页面独立持有各自的头部) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ======================================================== -->
        <!-- 分区 1: 【主页】(深度精髓致敬 KernelSU 风格)            -->
        <!-- ======================================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- 1.0 仅在主页展示的软件大标题 (对标 KernelSU) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="s1ngerAutoSign"
                    android:textColor="#1F1F1F"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- 1.1 核心大方块 (对标 KSU 工作中 LKM 蓝紫色大卡片) -->
                <LinearLayout
                    android:id="@+id/cardKsuHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_ksu_hero_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="20dp">

                    <ImageView
                        android:id="@+id/ivKsuStatusIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_ksu_check_circle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvKsuStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="工作中"
                                android:textColor="#001A41"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <!-- 模式角标：注明“无障碍”或“Root”，通俗易懂 -->
                            <TextView
                                android:id="@+id/tvKsuModeBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_ksu_mode_badge"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="无障碍"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvKsuVersionSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="版本：0.6.7"
                            android:textColor="#43474E"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 1.2 左右两个小方块 (定时时间 & 已打卡天数，字体不加粗，主次分明) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <!-- 左小方块: 定时时间 -->
                    <LinearLayout
                        android:id="@+id/cardKsuAlarm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pixel_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_alarm_time"
                            android:textColor="#444746"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvKsuAlarmTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="06:31"
                            android:textColor="#1F1F1F"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- 右小方块: 已打卡天数 -->
                    <LinearLayout
                        android:id="@+id/cardKsuSignDays"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pixel_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_signed_days"
                            android:textColor="#444746"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvKsuSignDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="1 天"
                            android:textColor="#1F1F1F"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 1.3 底部大方块: 系统与环境参数 (对标 KSU 安装状态卡片) -->
                <LinearLayout
                    android:id="@+id/cardKsuDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pixel_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_version_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="v0.6.7 (32)"
                        android:textColor="#1F1F1F"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/work_mode_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuWorkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="免 Root 智能无障碍模式"
                        android:textColor="#1F1F1F"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_model_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuDeviceModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Xiaomi Redmi 25053RT47C"
                        android:textColor="#1F1F1F"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/system_version_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuAndroidVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Android 15 (API 35)"
                        android:textColor="#1F1F1F"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fingerprint_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuFingerprint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="POCO/onyx_global/onyx:15/user/release-keys"
                        android:textColor="#1F1F1F"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- 权限状态独立换行展示，不用圆点 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/a11y_status_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuA11yStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="已开启"
                        android:textColor="#0B57D0"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/root_status_label"
                        android:textColor="#444746"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvKsuRootStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未授权"
                        android:textColor="#747775"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ======================================================== -->
        <!-- 分区 2: 【测试】(极客实时日志终端 + 控制按钮)            -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutTest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pixel_terminal"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_green_dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/log_terminal_title"
                        android:textColor="#A8C7FA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:text="@string/log_clear"
                        android:textColor="#C4C7C5"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnCopyLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pixel_btn_tonal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/log_copy"
                        android:textColor="#041E49"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnExportTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pixel_btn_tonal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/log_export"
                        android:textColor="#041E49"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <ScrollView
                        android:id="@+id/scrollLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvLogs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2dp"
                            android:text="[s1ngerAutoSign] 诊断终端就绪，等待执行指令...\n"
                            android:textColor="#E3E3E3"
                            android:textSize="11sp" />
                    </ScrollView>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestUnlock"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pixel_btn_primary"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/test_screen_off"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestNow"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pixel_btn_tonal"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/test_now"
                        android:textColor="#041E49"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForceStop"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pixel_btn_danger"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="@string/force_stop_task"
                    android:textColor="#B3261E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- 分区 3: 【设置】(模式选择、PIN码、定时修改与配置保存)     -->
        <!-- ======================================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- 模式切换卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pixel_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/core_work_mode"
                        android:textColor="#1F1F1F"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Root 模式分组 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/mode_root_title"
                        android:textColor="#0B57D0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbModeRootNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="#0B57D0"
                            android:paddingVertical="4dp"
                            android:text="@string/mode_normal_name"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbModeRootSprint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="#0B57D0"
                            android:paddingVertical="4dp"
                            android:text="@string/mode_sprint_name"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 无障碍模式分组 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/mode_a11y_title"
                        android:textColor="#0B57D0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbModeA11yNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="#0B57D0"
                            android:paddingVertical="4dp"
                            android:text="@string/mode_normal_name"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbModeA11ySkz"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="#0B57D0"
                            android:paddingVertical="4dp"
                            android:text="@string/mode_skz_name"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pixel_info_box"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        android:text="💡 模式说明：全自动后台静默提权与解锁，性能最强。"
                        android:textColor="#041E49"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 防断连与后台保活引导卡片 (位于模式选择下方) -->
                <LinearLayout
                    android:id="@+id/cardKeepAliveSetting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pixel_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/keep_alive_title"
                            android:textColor="#1F1F1F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/keep_alive_desc"
                            android:textColor="#5F6368"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pixel_btn_tonal"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="@string/goto_settings"
                        android:textColor="#041E49"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 界面语言设置卡片 -->
                <LinearLayout
                    android:id="@+id/cardLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pixel_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/language_title"
                            android:textColor="#1F1F1F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCurrentLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="简体中文"
                            android:textColor="#5F6368"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnChangeLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pixel_btn_tonal"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="@string/change_language"
                        android:textColor="#041E49"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 参数设定卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pixel_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/card_settings_title"
                        android:textColor="#1F1F1F"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- PIN 码输入区 (带显隐小眼睛切换) -->
                    <LinearLayout
                        android:id="@+id/layoutPinInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lockscreen_pin"
                            android:textColor="#444746"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:boxBackgroundColor="#FFFFFF"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="#0B57D0"
                            app:boxStrokeWidth="1.2dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#444746">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPin"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:hint="@string/pin_hint"
                                android:inputType="numberPassword"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:textColor="#1F1F1F"
                                android:textColorHint="#94A3B8"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 签到开始时间设定 (极速模式专用，其他模式置灰) -->
                    <LinearLayout
                        android:id="@+id/layoutSignStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sign_start_time"
                                android:textColor="#1F1F1F"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSignStartTimeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/sign_start_time_sub"
                                android:textColor="#747775"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSignStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="06:30"
                            android:textColor="#0B57D0"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSetStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_pixel_btn_tonal"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/modify_time"
                            android:textColor="#041E49"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 定时打卡时间设定 (普通模式专用，极速模式置灰) -->
                    <LinearLayout
                        android:id="@+id/layoutSignTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/daily_sign_time"
                                android:textColor="#1F1F1F"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSignTimeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/daily_sign_time_sub"
                                android:textColor="#747775"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSignTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="06:31"
                            android:textColor="#0B57D0"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSetTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_pixel_btn_tonal"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/modify_time"
                            android:textColor="#041E49"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 定时开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/enable_alarm"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDailyAlarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="#0B57D0"
                            app:trackTint="#D3E3FD" />
                    </LinearLayout>

                    <!-- 步骤异常自动重试上限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/retry_limit"
                            android:textColor="#1F1F1F"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/retry_limit_desc"
                            android:textColor="#747775"
                            android:textSize="11sp" />

                        <RadioGroup
                            android:id="@+id/rgMaxRetries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbRetry1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#0B57D0"
                                android:text="@string/retry_1"
                                android:textColor="#1F1F1F"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbRetry2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:buttonTint="#0B57D0"
                                android:text="@string/retry_2"
                                android:textColor="#1F1F1F"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbRetry3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:buttonTint="#0B57D0"
                                android:checked="true"
                                android:text="@string/retry_3"
                                android:textColor="#1F1F1F"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbRetry5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:buttonTint="#0B57D0"
                                android:text="@string/retry_5"
                                android:textColor="#1F1F1F"
                                android:textSize="13sp" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- 保存配置按钮 -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSaveConfig"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_pixel_btn_primary"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/save_settings"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- 底部三栏导航栏容器：背景浅灰(#EEF2F6)，向下延伸至屏幕最底端以完全包裹小白条手势区域 -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEF2F6"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDE3EA" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#EEF2F6"
            app:elevation="0dp"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

</LinearLayout>
